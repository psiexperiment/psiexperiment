import logging
log = logging.getLogger(__name__)

from functools import partial
from pathlib import Path
import threading
import time

from atom.api import Bool, Dict, set_default, Typed
import numpy as np
import pandas as pd
import zarr

from psidata.zarr_tools import ZarrSignal


from .base_store import BaseEpochData, BaseStore


def _retry_write(fn, *args, attempts=5, initial_delay=0.05, **kwargs):
    # zarr's LocalStore commits each chunk by writing a `.partial` file and
    # renaming it onto the final chunk path (os.replace). On Windows this
    # rename needs an exclusive handle to the destination, so if another
    # process (Defender real-time scanning, search indexer, etc.) has the
    # just-written chunk file open at that instant, the rename fails with
    # PermissionError (WinError 5). The lock is transient, so retrying with
    # backoff clears it without losing data.
    delay = initial_delay
    for attempt in range(attempts):
        try:
            return fn(*args, **kwargs)
        except PermissionError:
            if attempt == attempts - 1:
                raise
            log.warning('Transient PermissionError writing zarr chunk; '
                        'retrying (%d/%d)', attempt + 1, attempts)
            time.sleep(delay)
            delay *= 2


def _append(array, data, axis):
    # Never retry `zarr.Array.append` as a whole: it commits the resize before
    # writing chunks, so retrying after a failed chunk write grows the array a
    # second time, leaving a block of fill values and shifting every later
    # sample. Resizing to an absolute shape and writing to an explicit slice
    # are each idempotent, so they can be retried independently.
    old_size = array.shape[axis]
    new_shape = list(array.shape)
    new_shape[axis] = old_size + data.shape[axis]
    _retry_write(array.resize, tuple(new_shape))
    selection = [slice(None)] * array.ndim
    selection[axis] = slice(old_size, new_shape[axis])
    _retry_write(array.__setitem__, tuple(selection), data)


class ChunkedAppender:
    '''
    A zarr array grown along its last axis and written a whole chunk at a
    time.

    Appending each block as it arrives rewrites the chunk it lands in, and
    the array's metadata, on every block: a compressed read-modify-write of
    the chunk and an atomic file replace, for every input. On Windows that
    took most of the time between blocks of a sound card, so the inputs fell
    behind. Instead, blocks are held here until they fill a chunk.

    Reading through this (`shape`, indexing, as `ZarrSignal` does) writes
    out whatever is held first, so readers in the experiment see everything
    appended. Anything reading the files on disk sees whole chunks only
    until `flush`, which writes the rest, after which appends are written
    straight through (anything arriving after the experiment ends).
    '''

    def __init__(self, array):
        self.array = array
        self.attrs = array.attrs
        self.chunks = array.chunks
        self._chunk = array.chunks[-1]
        self._pending = []
        self._n_pending = 0
        self._write_through = False
        # Appends come from the input thread, reads from any other.
        self._lock = threading.RLock()

    @property
    def length(self):
        '''
        Samples appended, written or not.
        '''
        with self._lock:
            return self.array.shape[-1] + self._n_pending

    def append(self, data):
        data = np.asarray(data)
        with self._lock:
            self._pending.append(data)
            self._n_pending += data.shape[-1]
            written = self.array.shape[-1]
            end = written + self._n_pending
            if not self._write_through:
                # Up to the last chunk boundary, so a chunk is written once
                # it is full (or, after a read wrote part of one, once the
                # rest of it arrives).
                end = end // self._chunk * self._chunk
            self._write(end - written)

    def _write(self, n):
        if n <= 0:
            return
        data = np.concatenate(self._pending, axis=-1)
        _append(self.array, data[..., :n], axis=data.ndim - 1)
        rest = data[..., n:]
        self._pending = [rest] if rest.shape[-1] else []
        self._n_pending = rest.shape[-1]

    def sync(self):
        '''
        Write out everything appended so far.
        '''
        with self._lock:
            self._write(self._n_pending)

    def flush(self):
        '''
        Write out everything appended so far, and from now on write each
        append as it comes.
        '''
        with self._lock:
            self._write(self._n_pending)
            self._write_through = True

    @property
    def shape(self):
        self.sync()
        return self.array.shape

    @property
    def ndim(self):
        return self.array.ndim

    @property
    def dtype(self):
        return self.array.dtype

    def __getitem__(self, key):
        self.sync()
        return self.array[key]

    def __array__(self, dtype=None, copy=None):
        return np.asarray(self[...], dtype=dtype)


class ZarrEpochData(BaseEpochData):

    metadata_filename = Typed(Path)
    dirty = Bool(False)

    def append(self, data):
        epochs, metadata = self._split_epochs_metadata(data)
        epochs = np.concatenate(epochs, axis=-1)
        self.data.append(epochs)
        self.metadata.extend(metadata)
        self.dirty = True

    def flush(self):
        self.data.flush()
        if self.dirty:
            pd.DataFrame(self.metadata).to_csv(self.metadata_filename)
            self.dirty = False


class ZarrStore(BaseStore):
    '''
    Simple class for storing acquired trial data in hierarchy of zarr folders.
    '''
    name = set_default('zarr_store')
    _stores = Dict()

    def get_source(self, name):
        try:
            return ZarrSignal(self._stores[name])
        except KeyError as e:
            raise AttributeError(name)

    def process_ai_continuous(self, name, data):
        store = self._stores[name]
        self._check_continuity(name, data, store.length)
        store.append(data)

    def process_ai_epochs(self, name, data):
        self._stores[name].append(data)

    def _create_array(self, name, fs, dtype, metadata):
        filename = self.get_filename(name).with_suffix('.zarr')

        channels = metadata.get('n_channels', None)
        if channels is None:
            time_chunksize = (2 ** 20) / np.dtype(dtype).itemsize
            time_chunksize = int(round(time_chunksize))
            shape = (0,)
            chunkshape = (time_chunksize,)
        else:
            time_chunksize = (2 ** 20) / np.dtype(dtype).itemsize / channels
            shape = (channels, 0)
            time_chunksize = int(round(time_chunksize))
            chunkshape = (channels, time_chunksize)
        zarray = zarr.create(shape, store=str(filename), dtype=dtype,
                             chunks=chunkshape)
        zarray.attrs['fs'] = fs
        for key, value in metadata.items():
            zarray.attrs[key] = value
        return ChunkedAppender(zarray)

    def create_ai_continuous(self, name, fs, dtype, metadata):
        self._stores[name] = self._create_array(name, fs, dtype, metadata)

    def create_ai_epochs(self, name, fs, dtype, metadata):
        zarray = self._create_array(name, fs, dtype, metadata)
        md_filename = self.get_filename(f'{name}_metadata', '.csv')
        self._stores[name] = ZarrEpochData(fs=fs, data=zarray, metadata=[],
                                           metadata_filename=md_filename)

    def finalize(self, workbench):
        # Save the settings file
        cmd = 'psi.save_preferences'
        filename = self.base_path / 'final'
        params = {'filename': filename}
        core = workbench.get_plugin('enaml.workbench.core')
        core.invoke_command(cmd, params)

    def get_ai_signal(self, name):
        from psidata.zarr_tools import ZarrSignal
        return ZarrSignal(self._stores[name])
